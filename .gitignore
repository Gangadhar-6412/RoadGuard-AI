# Local Python environments and generated bytecode
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Runtime state is local and may contain user-submitted images, SQLite data,
# inference artifacts, and machine-specific evaluation output.
data/
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*

# Keep only the active, attributed model checkpoint in the deployable repo.
# At 18,966,618 bytes it is below GitHub's 100 MB per-file limit.
models/*.pt
!models/pothole_yolo12s_rdd2022.pt
models/*.download

# Local secrets and environment files
.env
.env.*
!.env.example
.streamlit/secrets.toml
